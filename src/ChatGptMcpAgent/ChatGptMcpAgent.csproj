<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChatGptMcpAgent</AssemblyName>
    <RootNamespace>ChatGptMcpAgent</RootNamespace>
    <Version>0.2.65</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ControlState.cs" Link="ControlState.cs" />
    <Compile Include="../Shared/ControlExecutor.cs" Link="ControlExecutor.cs" />
    <Compile Include="../Shared/ControlActivityLabels.cs" Link="ControlActivityLabels.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Historic text-only chat remains in Git for migration/rollback, but does
         not ship in the executable. Only ChatGptMainForm displays chatgpt.com. -->
    <Compile Remove="ChatWindow.cs" />
    <Compile Remove="ChatSessionStore.cs" />
    <Compile Remove="ChatCloudImportDialog.cs" />
    <Compile Remove="BrowserChatWorker.cs" />
    <Compile Remove="WebViewChatHost.cs" />
    <Compile Remove="ChatGptWebViewAuthForm.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Themes\\ChatGPT-Warm-Dark.css" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Themes\\ChatGPT-Toolbar.js" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Themes\\ChatGPT-Context.js" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Themes\\ChatGPT-Voice.js" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Themes\\BrowserChrome.html" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
