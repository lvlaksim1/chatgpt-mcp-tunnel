<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ChatGptMcpAgent</AssemblyName>
    <RootNamespace>ChatGptMcpAgent</RootNamespace>
    <Version>0.2.47</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ControlState.cs" Link="ControlState.cs" />
    <Compile Include="../Shared/ControlExecutor.cs" Link="ControlExecutor.cs" />
    <Compile Include="../Shared/ControlActivityLabels.cs" Link="ControlActivityLabels.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
